/*
 * Corne 5-Column (36 Tasten) mit deutschem QWERTZ
 * Voraussetzung: Betriebssystem steht auf deutschem Tastaturlayout.
 * ZMK sendet HID Codes (US-Positionen), das OS macht daraus QWERTZ.
 * Darum steht fuer "Z" der HID Code Y und umgekehrt.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/* Deutsche Sonderzeichen (HID Code + Modifier) */
#define DE_AE   SQT
#define DE_OE   SEMI
#define DE_UE   LBKT
#define DE_SS   MINUS
#define DE_EXCL LS(N1)
#define DE_DQT  LS(N2)
#define DE_SECT LS(N3)
#define DE_DLR  LS(N4)
#define DE_PRCT LS(N5)
#define DE_AMPS LS(N6)
#define DE_SLSH LS(N7)
#define DE_LPAR LS(N8)
#define DE_RPAR LS(N9)
#define DE_EQL  LS(N0)
#define DE_QMARK LS(MINUS)
#define DE_PLUS RBKT
#define DE_STAR LS(RBKT)
#define DE_HASH NUHS
#define DE_LT   NUBS
#define DE_GT   LS(NUBS)
#define DE_PIPE RA(NUBS)
#define DE_BSLH RA(MINUS)
#define DE_AT   RA(Q)
#define DE_EURO RA(E)
#define DE_LBRC RA(N8)
#define DE_RBRC RA(N9)
#define DE_LCBR RA(N7)
#define DE_RCBR RA(N0)
#define DE_TILD RA(RBKT)
#define DE_MINS SLASH
#define DE_COLN LS(DOT)
#define DE_SEMI LS(COMMA)

#define BASE 0
#define SYM  1
#define NAV  2

/ {
    combos {
        compatible = "zmk,combos";

        /* Ue: P + Oe */
        combo_ue {
            timeout-ms = <40>;
            key-positions = <10 22>;
            bindings = <&kp DE_UE>;
        };
        /* Ae: Oe + Minus (untere Reihe rechts) */
        combo_ae {
            timeout-ms = <40>;
            key-positions = <22 34>;
            bindings = <&kp DE_AE>;
        };
        /* ss: O + P */
        combo_ss {
            timeout-ms = <40>;
            key-positions = <9 10>;
            bindings = <&kp DE_SS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "QWERTZ";
            bindings = <
&none &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &none
&none &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp DE_OE &none
&none &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp DE_MINS &none
&kp LGUI &lt SYM SPACE &kp LSHFT &kp RET &lt NAV BSPC &kp RALT
            >;
        };

        sym_layer {
            label = "Symbole";
            bindings = <
&none &kp DE_EXCL &kp DE_DQT &kp DE_SECT &kp DE_DLR &kp DE_PRCT &kp DE_AMPS &kp DE_SLSH &kp DE_LPAR &kp DE_RPAR &kp DE_EQL &none
&none &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &none
&none &kp DE_LT &kp DE_GT &kp DE_AT &kp DE_HASH &kp DE_BSLH &kp DE_QMARK &kp DE_LBRC &kp DE_RBRC &kp DE_PLUS &kp DE_STAR &none
&trans &trans &trans &trans &kp DE_PIPE &kp DE_EURO
            >;
        };

        nav_layer {
            label = "Navigation";
            bindings = <
&none &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp PG_UP &kp HOME &kp UP &kp END &kp DEL &none
&none &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp PG_DN &kp LEFT &kp DOWN &kp RIGHT &kp BSPC &none
&none &kp F11 &kp F12 &kp TAB &kp ESC &bt BT_CLR &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_PP &kp DE_TILD &none
&trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
